etings" type="id"/><item name="display_number" type="id"/><item name="manually_number" type="id"/><item name="memo" type="id"/><item name="scan_progress" type="id"/><item name="title_action_bar" type="id"/><item name="tip_begin" type="id"/></file><file path="D:\docs\Codex\iforward-modern\app\src\main\res\values\strings.xml" qualifiers=""><string name="app_name">安心转接</string><string name="app_subtitle">按运营商呼叫转移规则处理来电</string><string name="more_options">更多选项</string><string name="number_page_title">转接号码</string><string name="number_page_hint">设置运营商“遇忙转接”的目标号码</string><string name="no_data">无数据</string><string name="ok">确定</string><string name="cancle">取消</string><string name="forward_number">转接号码</string><string name="forward_object">转接对象</string><string name="forward_history">转接历史</string><string name="forward_object_default_display">转接对象(0)</string><string name="tip_no_content">需录入转接号码</string><string name="tip_no_item_selected">未曾选择</string><string name="settings">设置</string><string name="about">关于</string><string name="manually_add">手动添加</string><string name="transferred_to">来电被转至</string><string name="delete">移除</string><string name="export">导出</string><string name="clear">清除</string><string name="manually_add_number">手动添加号码</string><string name="contacts_add_number">从联系人选择</string><string name="calllogs_add_number">从通话记录选择</string><string name="add_forward_object">添加转接对象</string><string name="tip">友情提示</string><string name="tip_clear">清除转接历史?</string><string name="memo">备注名称</string><string name="mobile_tel_num">手机|座机</string><string name="tip_no_number_settings">未设置号码</string><string name="number_settings">号码设置</string><string name="disable_forward_number">禁用号码转接</string><string name="tip_history_export_to">历史记录导出至:</string><string name="tip_export_success">导出成功</string><string name="tip_export_nodata">无数据导出</string><string name="tip_forward_number_settings">启用转接功能请先设置转接号码</string><string name="guide">操作指引</string><string name="app_start">开始体验</string><string name="time_window_title">转接时间段</string><string name="time_window_enable">启用时间段限制</string><string name="time_window_hint">仅在此时间段内拒接符合号码条件的来电；支持跨午夜设置。</string><string name="time_window_start">开始 %1$s</string><string name="time_window_end">结束 %1$s</string><string name="about_app_desc">轻量、纯粹、基于运营商呼叫转移规则的智能来电过滤与转接工具</string><string name="about_version">v%1$s (Android 10+ 适配版)</string><string name="about_version_display">v3.0.0 (Android 10+ 适配版)</string><string name="about_section_intro">软件简介</string><string name="about_intro_content">日常生活中，我们常遇到不想接听又不好生硬挂断的电话，或者在会议、休息时希望转由他人代接。安心转接保持极致轻量、零常驻守护进程、无广告、纯净开源，将 Android 系统原生来电筛选能力与运营商底层呼叫转移深度结合，优雅实现对特定来电的无感转接与拟真拦截。</string><string name="about_section_principle">核心原理</string><string name="about_principle_content">安心转接的拦截原理，本质是“定向触发运营商的遇忙转移”：\n\n1. 来电呼入时，通过 Android 官方 CallScreeningService 检查转接名单与生效时间段；\n2. 命中后立即拒绝接听，向基站返回“忙线/占线”状态；\n3. 运营商网络识别到占线后，自动触发预先配置的“遇忙呼叫转移”；\n4. 来电被自动转移至目标号码（如备用机、座机）或返回运营商系统提示音（如空号、关机、停机）。\n\n★ 全部转接由运营商网络侧执行，App 本身不发起二次呼叫，安全、省电、无延迟。</string><string name="about_section_features">功能特性</string><string name="about_features_content">▪ 定向转接名单：针对特定联系人/号码精准过滤，不影响正常通讯\n▪ 便捷添加：支持手动输入、通讯录导入与通话记录添加\n▪ 时间段控制：支持设置生效时间窗口（支持跨午夜，如 22:00 ~ 07:00）\n▪ 历史记录与导出：完整记录每次拦截转接详情，支持导出备份\n▪ 轻量省电：无常驻后台、无广告追踪、全面保护隐私</string><string name="about_section_guide">使用须知</string><string name="about_guide_content">1. 开启运营商“遇忙呼叫转移”：使用前需在手机拨号设置中配置“遇忙转移”号码，或通过运营商常用 USSD 拨号代码设置：\n   • 开启遇忙转移：拨打 **67*目标号码#\n   • 取消遇忙转移：拨打 ##67#\n   • 查询当前状态：拨打 *#67#\n\n2. 系统权限要求：首次启动请授予“默认来电筛选应用”及“通讯录读取”权限，以确保拦截与姓名匹配生效。</string><string name="about_section_thanks">开源与致谢</string><string name="about_thanks_content">本应用完全开源免费。\n特别致敬原作者 Hanley 以及最初参与设计讨论的早期贡献者，感谢开源社区的支持。</string><string name="app_intrudoction">日常生活中，我们常遇到不想接听又不好生硬挂断的电话。安心转接保持极致轻量、零常驻守护进程、无广告、纯净开源，将 Android 原生来电筛选与运营商遇忙转移结合，实现精准转接与拟真拦截。</string><string name="thanks">开源致谢</string><string name="thanks_content">特别感谢原作者 Hanley 以及早期贡献者，感谢开源社区的支持与肯定！</string></file><file path="D:\docs\Codex\iforward-modern\app\