    </style></file><file path="D:\docs\Codex\iforward-modern\app\src\main\res\values-zh-rCN\strings.xml" qualifiers="zh-rCN"><string name="app_name">安心转接</string><string name="app_subtitle">按运营商呼叫转移规则处理来电</string><string name="more_options">更多选项</string><string name="number_page_title">转接号码</string><string name="number_page_hint">设置运营商“遇忙转接”的目标号码</string><string name="no_data">无数据</string><string name="ok">确定</string><string name="cancle">取消</string><string name="forward_number">转接号码</string><string name="forward_object">转接对象</string><string name="forward_history">转接历史</string><string name="forward_object_default_display">转接对象(0)</string><string name="tip_no_content">需录入转接号码</string><string name="tip_no_item_selected">未曾选择</string><string name="settings">设置</string><string name="about">关于</string><string name="manually_add">手动添加</string><string name="transferred_to">来电被转至</string><string name="delete">移除</string><string name="export">导出</string><string name="clear">清除</string><string name="manually_add_number">手动添加号码</string><string name="contacts_add_number">从联系人选择</string><string name="calllogs_add_number">从通话记录选择</string><string name="add_forward_object">添加转接对象</string><string name="tip">友情提示</string><string name="tip_clear">清除转接历史?</string><string name="memo">备注名称</string><string name="mobile_tel_num">手机|座机</string><string name="tip_no_number_settings">未设置号码</string><string name="number_settings">号码设置</string><string name="disable_forward_number">禁用号码转接</string><string name="tip_history_export_to">历史记录导出至:</string><string name="tip_export_success">导出成功</string><string name="tip_export_nodata">无数据导出</string><string name="tip_forward_number_settings">启用转接功能请先设置转接号码</string><string name="guide">操作指引</string><string name="app_start">开始体验</string><string name="time_window_title">转接时间段</string><string name="time_window_enable">启用时间段限制</string><string name="time_window_hint">仅在此时间段内拒接符合号码条件的来电；支持跨午夜设置。</string><string name="time_window_start">开始 %1$s</string><string name="time_window_end">结束 %1$s</string><string name="about_app_desc">轻量、纯粹、基于运营商呼叫转移规则的智能来电过滤与转接工具</string><string name="about_version">v%1$s (Android 10+ 适配版)</string><string name="about_version_display">v3.0.0 (Android 10+ 适配版)</string><string name="about_section_intro">软件简介</string><string name="about_intro_content">日常生活中，我们常遇到不想接听又不好生硬挂断的电话，或者在会议、休息时希望转由他人代接。安心转接保持极致轻量、零常驻守护进程、无广告、纯净开源，将 Android 系统原生来电筛选能力与运营商底层呼叫转移深度结合，优雅实现对特定来电的无感转接与拟真拦截。</string><string name="about_section_principle">核心原理</string><string name="about_principle_content">安心转接的拦截原理，本质是“定向触发运营商的遇忙转移”：\n\n1. 来电呼入时，通过 Android 官方 CallScreeningService 检查转接名单与生效时间段；\n2. 命中后立即拒绝接听，向基站返回“忙线/占线”状态；\n3. 运营商网络识别到占线后，自动触发预先配置的“遇忙呼叫转移”；\n4. 来电被自动转移至目标号码（如备用机、座机）或返回运营商系统提示音（如空号、关机、停机）。\n\n★ 全部转接由运营商网络侧执行，App 本身不发起二次呼叫，安全、省电、无延迟。</string><string name="about_section_features">功能特性</string><string name="about_features_content">▪ 定向转接名单：针对特定联系人/号码精准过滤，不影响正常通讯\n▪ 便捷添加：支持手动输入、通讯录导入与通话记录添加\n▪ 时间段控制：支持设置生效时间窗口（支持跨午夜，如 22:00 ~ 07:00）\n▪ 历史记录与导出：完整记录每次拦截转接详情，支持导出备份\n▪ 轻量省电：无常驻后台、无广告追踪、全面保护隐私</string><string name="about_section_guide">使用须知</string><string name="about_guide_content">1. 开启运营商“遇忙呼叫转移”：使用前需在手机拨号设置中配置“遇忙转移”号码，或通过运营商常用 USSD 拨号代码设置：\n   • 开启遇忙转移：拨打 **67*目标号码#\n   • 取消遇忙转移：拨打 ##67#\n   • 查询当前状态：拨打 *#67#\n\n2. 系统权限要求：首次启动请授予“默认来电筛选应用”及“通讯录读取”权限，以确保拦截与姓名匹配生效。</string><string name="about_section_thanks">开源与致谢</string><string name="about_thanks_content">本应用完全开源免费。\n特别致敬原作者 Hanley 以及最初参与设计讨论的早期贡献者，感谢开源社区的支持。</string><string name="app_intrudoction">日常生活中，我们常遇到不想接听又不好生硬挂断的电话。安心转接保持极致轻量、零常驻守护进程、无广告、纯净开源，将 Android 原生来电筛选与运营商遇忙转移结合，实现精准转接与拟真拦截。</string><string name="thanks">开源致谢</string><string name="thanks_content">特别感谢原作者 Hanley 以及早期贡献者，感谢开源社区的支持与肯定！</string></file><file path="D:\docs\Codex\iforward-modern\app\src\main\res\values-zh-rTW\strings.xml" qualifiers="zh-rTW"><string name="app_name">安心转接</string><string name="app_subtitle">依電信業者呼叫轉接規則處理來電</string><string name="more_options">更多選項</string><string name="number_page_title">轉接號碼</string><string name="number_page_hint">設定電信業者「遇忙轉接」的目標號碼</string><string name="no_data">無數據</string><string name="ok">確定</string><string name="cancle">取消</string><string name="forward_number">轉接號碼</string><string name="forward_object">轉接對象</string><string name="forward_history">轉接歷史</string><string name="forward_object_default_display">轉接對象(0)</string><string name="tip_no_content">需要錄入號碼</string><string name="tip_no_item_selected">未曾選擇</string><string name="settings">設定</string><string name="about">關於</string><string name="manually_add">手動新增</string><string name="transferred_to">來電被轉至</string><string name="delete">移除</string><string name="export">導出</string><string name="clear">清除</string><string name="manually_add_number">手動新增號碼</string><string name="contacts_add_number">從聯絡人選擇</string><string name="calllogs_add_number">從通話歷史選擇</string><string name="add_forward_object">新增轉接對象</string><string name="tip">友好提示</string><string name="tip_clear">清除歷史記錄?</string><string name="memo">備註一下</string><string name="mobile_tel_num">手機|座機</string><string name="tip_no_number_settings">未設定號碼</string><string name="number_settings">號碼設定</string><string name="disable_forward_number">禁用號碼轉接</string><string name="tip_history_export_to">歷史記錄導出至:</string><string name="tip_export_success">導出成功</string><string name="tip_export_nodata">無數據可導出</string><string name="tip_forward_number_settings">啓用轉接功能請先設定轉接號碼</string><string name="guide">操作指引</string><string name="app_start">開始體驗</string><string name="time_window_title">轉接時段</string><string name="time_window_enable">啟用時段限制</string><string name="time_window_hint">僅在此時段內拒接符合號碼條件的來電；支援跨午夜設定。</string><string name="time_window_start">開始 %1$s</string><string name="time_window_end">結束 %1$s</string><string name="about_app_desc">輕量、純粹、基於電信業者呼叫轉接規則的智慧來電過濾與轉接工具</string><string name="about_version">v%1$s (Android 10+ 適配版)</string><string name="about_version_display">v3.0.0 (Android 10+ 適配版)</string><string name="about_section_intro">軟體簡介</string><string name="about_intro_content">日常生活中，我們常遇到不想接聽又不好生硬掛斷的電話，或者在會議、休息時希望轉由他人代接。安心轉接保持極致輕量、零常駐守護進程、無廣告、純淨開源，將 Android 系統原生來電篩選能力與電信業者底層呼叫轉接深度結合，優雅實現對特定來電的無感轉接與擬真攔截。</string><string name="about_section_principle">核心原理</string><string name="about_principle_content">安心轉接的攔截原理，本質是「定向觸發電信業者的遇忙轉移」：\n\n1. 來電呼入時，透過 Android 官方 CallScreeningService 檢查轉接名單與生效時段；\n2. 命中後立即拒絕接聽，向基地台返回「忙線/佔線」狀態；\n3. 電信業者網路識別到佔線後，自動觸發預先設定的「遇忙呼叫轉移」；\n4. 來電被自動轉移至目標號碼（如備用機、座機）或返回電信業者系統提示音（如空號、關機、停機）。\n\n★ 全部轉接由電信業者網路端執行，App 本身不發起二次呼叫，安全、省電、無延遲。</string><string name="about_section_features">功能特性</string><string name="about_features_content">▪ 定向轉接名單：針對特定聯絡人/號碼精準過濾，不影響正常通訊\n▪ 便捷新增：支援手動輸入、聯絡人匯入與通話記錄新增\n▪ 時段控制：支援設定生效時段窗口（支援跨午夜，如 22:00 ~ 07:00）\n▪ 歷史記錄與匯出：完整記錄每次攔截轉接詳情，支援匯出備份\n▪ 輕量省電：無常駐背景、無廣告追蹤、全面保護隱私</string><string name="about_section_guide">使用須知</string><string name="about_guide_content">1. 開啟電信業者「遇忙呼叫轉移」：使用前需在手機撥號設定中配置「遇忙轉移」號碼，或透過電信業者常用 USSD 撥號代碼設定：\n   • 開啟遇忙轉移：撥打 **67*目標號碼#\n   • 取消遇忙轉移：撥打 ##67#\n   • 查詢目前狀態：撥打 *#67#\n\n2. 系統權限要求：首次啟動請授予「預設來電篩選應用」及「聯絡人讀取」權限，以確保攔截與姓名匹配生效。</string><string name="about_section_thanks">開源與致謝</string><string name="about_thanks_content">本應用程式完全開源免費。\n特別致敬原作者 Hanley 以及最初參與設計討論的早期貢獻者，感謝開源社群的支持。</string><string name="app_intrudoction">日常生活中，我們常遇到不想接聽又不好生硬掛斷的電話。安心轉接保持極致輕量、零常駐守護進程、無廣告、純淨開源，將 Android 原生來電篩選與電信業者遇忙轉移結合，實現精準轉接與擬真攔截。</string><string name="thanks">開源致謝</string><string name="thanks_content">特別感謝原作者 Hanley 以及早期貢獻者，感謝開源社群的支持與肯定！</string></file></source></dataSet><dataSet aapt-namespace="http://schemas.android.com/apk/res-auto" config="release$Generated" generated="true" ignore_pattern="!.svn:!.git:!.ds_store:!*.scc:.*:&lt;dir>_*:!CVS:!thumbs.db:!picasa.ini:!*~"><source path="D:\docs\Codex\iforward-modern\app\src\release\res"/></dataSet><dataSet aapt-namespace="http://schemas.android.com/apk/res-auto" config="release" generated-set="release$Generated" ignore_pattern="!.svn:!.git:!.ds_store:!*.scc:.*:&lt;dir>_*:!CVS:!thumbs.db:!picasa.ini:!*~"><source path="D:\docs\Codex\iforward-modern\app\src\release\res"/></dataSet><dataSet aapt-namespace="http://schemas.android.com/apk/res-auto" config="generated$Generated" generated="true" ignore_pattern="!.svn:!.git:!.ds_store:!*.scc:.*:&lt;dir>_*:!CVS:!thumbs.db:!picasa.ini:!*~"><source path="D:\docs\Codex\iforward-modern\app\build\generated\res\resValues\release"/></dataSet><dataSet aapt-namespace="http://schemas.android.com/apk/res-auto" config="generated" generated-set="generated$Generated" ignore_pattern="!.svn:!.git:!.ds_store:!*.scc:.*:&lt;dir>_*:!CVS:!thumbs.db:!picasa.ini:!*~"><source path="D:\docs\Codex\iforward-modern\app\build\generated\res\resValues\release"/></dataSet><mergedItems/></merger>