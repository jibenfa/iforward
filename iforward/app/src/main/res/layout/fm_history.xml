<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="14dp"
    android:paddingEnd="16dp" android:paddingBottom="8dp" android:background="@color/page_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
        <Button android:id="@id/export" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="@drawable/bg_button_secondary"
            android:text="@string/export" android:textColor="@color/brand_teal" android:textSize="14sp" android:textStyle="bold" />
        <Button android:id="@id/clear" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="10dp" android:background="@drawable/bg_button_secondary"
            android:text="@string/clear" android:textColor="@color/text_secondary" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="12dp">
        <ListView android:id="@android:id/list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@android:color/transparent" android:divider="@color/divider" android:dividerHeight="1dp"
            android:drawSelectorOnTop="false" android:fastScrollEnabled="true" android:clipToPadding="false" />
        <TextView android:id="@android:id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:text="@string/no_data" android:textColor="@color/text_secondary" android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
