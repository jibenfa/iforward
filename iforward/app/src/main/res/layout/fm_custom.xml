<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/page_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_horizontal" android:orientation="vertical"
        android:paddingStart="20dp" android:paddingTop="32dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/number_page_title" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/number_page_hint" android:textColor="@color/text_secondary" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="vertical" android:padding="22dp"
            android:background="@drawable/bg_card" android:elevation="2dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/forward_number" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <TextView android:id="@id/display_number" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/tip_no_number_settings"
                android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
            <Button android:id="@id/number_setings" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="20dp" android:background="@drawable/bg_button_primary"
                android:text="@string/number_settings" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@id/tip_begin" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:gravity="center" android:text="@string/tip_forward_number_settings"
            android:textColor="@color/warning" android:textSize="14sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:orientation="vertical" android:padding="18dp"
            android:background="@drawable/bg_card" android:elevation="2dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/time_window_title" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <Switch android:id="@+id/time_window_switch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/time_window_enable" android:textColor="@color/text_primary" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="@string/time_window_hint"
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="horizontal">
                <Button android:id="@+id/time_window_start" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary" android:textColor="@color/text_primary" />
                <Button android:id="@+id/time_window_end" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_marginStart="10dp" android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary" android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
