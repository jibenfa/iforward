<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="14dp"
    android:paddingEnd="16dp" android:paddingBottom="8dp" android:background="@color/page_background">
    <Button android:id="@id/btn_add_forward_num" android:layout_width="match_parent"
        android:layout_height="52dp" android:background="@drawable/bg_button_primary"
        android:text="@string/add_forward_object" android:textColor="@android:color/white"
        android:textSize="16sp" android:textStyle="bold" android:elevation="2dp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="12dp">
        <ListView android:id="@android:id/list" android:layout_width="match_parent"
            android:layout_height="match_parent" android:background="@android:color/transparent"
            android:divider="@color/divider" android:dividerHeight="1dp"
            android:drawSelectorOnTop="false" android:fastScrollEnabled="true" android:clipToPadding="false" />
        <TextView android:id="@android:id/empty" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center" android:text="@string/no_data"
            android:textColor="@color/text_secondary" android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
